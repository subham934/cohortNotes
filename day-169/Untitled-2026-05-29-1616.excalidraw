      "seed": 167946498,
      "version": 97,
      "versionNonce": 1167742174,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788968384115,
      "link": null,
      "locked": false,
      "text": "\nwe have a sandbox service, user request to api/sandbox/start, when we call this API, \nsandbox service will do the following::\n\n- create a new container\n- return the preview URL : with this URL, user can see the preview of the code\n- return terminal URL: with this URL, we can access our terminal, it is a websocket \nURL with which we will access the terminal. we will use node-pty",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nwe have a sandbox service, user request to api/sandbox/start, when we call this API, \nsandbox service will do the following::\n\n- create a new container\n- return the preview URL : with this URL, user can see the preview of the code\n- return terminal URL: with this URL, we can access our terminal, it is a websocket \nURL with which we will access the terminal. we will use node-pty",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
