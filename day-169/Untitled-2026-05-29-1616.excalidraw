      "seed": 494873858,
      "version": 33,
      "versionNonce": 1212730498,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788971209534,
      "link": null,
      "locked": false,
      "text": "service",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
