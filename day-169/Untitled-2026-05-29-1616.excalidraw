    {
      "id": "W5Gg-gSJFQ5xt-al-O5lO",
      "type": "text",
      "x": -279.09527718844436,
      "y": 4456.137915497411,
      "width": 1249.1669921875,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b47",
      "roundness": null,
      "seed": 1595358,
      "version": 15,
      "versionNonce": 118220510,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788973220196,
      "link": null,
      "locked": false,
      "text": "Now, lets see an architecture, inside our main kubernetes cluster, we will have 4 pods for 4 different services running, Auth, Notification, AI orchestration \nand Sandbox. Now, this is a bundle of 4 main pods where our actual application is running. Now, when a user request to the sandbox service, the sandbox \nservice will create a new pod/container for that user and will return the preview URL and terminal URL. So, for each user we will have a new pod/container \ncreated by the sandbox service. The user pods will have the vite-dev-server running and the user can see the preview of the code and can also access the \nterminal. This user pod is controlled by the sandbox service, when the user is done with the code execution, the user can request to delete the pod/container \nand the sandbox service will delete that pod/container. So, we will have 2 types of pods, one is main pods for our application and another is user pods for \neach user.\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now, lets see an architecture, inside our main kubernetes cluster, we will have 4 pods for 4 different services running, Auth, Notification, AI orchestration \nand Sandbox. Now, this is a bundle of 4 main pods where our actual application is running. Now, when a user request to the sandbox service, the sandbox \nservice will create a new pod/container for that user and will return the preview URL and terminal URL. So, for each user we will have a new pod/container \ncreated by the sandbox service. The user pods will have the vite-dev-server running and the user can see the preview of the code and can also access the \nterminal. This user pod is controlled by the sandbox service, when the user is done with the code execution, the user can request to delete the pod/container \nand the sandbox service will delete that pod/container. So, we will have 2 types of pods, one is main pods for our application and another is user pods for \neach user.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
