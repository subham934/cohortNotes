    {
      "id": "AP28dj2EqOdqWmLJBh6-U",
      "type": "text",
      "x": 487.4136672247022,
      "y": 4162.126984126985,
      "width": 680.5274658203125,
      "height": 160,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
