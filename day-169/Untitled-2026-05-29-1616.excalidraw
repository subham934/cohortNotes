    {
      "id": "VkWg4syqfV-lMJE3ZMA7Q",
      "type": "text",
      "x": 39.779886284884014,
      "y": 4789.4033583292,
      "width": 52.83195495605469,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b46",
