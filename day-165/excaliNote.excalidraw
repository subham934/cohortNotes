    {
      "id": "Gwa3L3trZbJDEC4BzFPRB",
      "type": "text",
      "x": 307,
      "y": 274,
      "width": 721.5989990234375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b09",
      "roundness": null,
      "seed": 1188268344,
      "version": 39,
      "versionNonce": 1786710584,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787672884666,
      "link": null,
      "locked": false,
      "text": "Pod is a server. agar load badh gaya toh number of pods increase karenge. \nDeployment is the one that manages the pods. Deployment ka kaam hain ki agar\nserver ka version update karna hain toh purane server ko rakhega but parallelly \nnaye server ko deploy karega phir wo check karega ki jo naya version hain wo \nsahi se kaam kar raha hain ya nahi. Agar sahi se kaam kar raha hain toh purane \nserver ko ak ak karke down kar dega aur traffic ko naye server se route kar dega.\nAgar nahi kar raha hain toh purane server ko rakhega aur naye server ko hata dega.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pod is a server. agar load badh gaya toh number of pods increase karenge. \nDeployment is the one that manages the pods. Deployment ka kaam hain ki agar\nserver ka version update karna hain toh purane server ko rakhega but parallelly \nnaye server ko deploy karega phir wo check karega ki jo naya version hain wo \nsahi se kaam kar raha hain ya nahi. Agar sahi se kaam kar raha hain toh purane \nserver ko ak ak karke down kar dega aur traffic ko naye server se route kar dega.\nAgar nahi kar raha hain toh purane server ko rakhega aur naye server ko hata dega.",
      "autoResize": true,
      "lineHeight": 1.25
    },
